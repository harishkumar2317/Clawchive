# PostgreSQL connection string used by the API and worker.
DATABASE_URL=postgresql://user:password@host:5432/clawchive

# Google Gemini API key for the default inference adapter.
GEMINI_API_KEY=your_gemini_api_key

# Moondream Cloud API key for the alternate inference adapter.
MOONDREAM_API_KEY=your_moondream_api_key

# Inference backend selection (for example: gemini or moondream_cloud).
INFERENCE_ADAPTER=gemini

# Telegram bot token used by the webhook receiver.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
